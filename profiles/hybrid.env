# Hybride (défaut) : DeepSeek (OpenRouter) pour réfléchir, Whisper et Piper locaux pour l'écoute et la voix
# Aucun modèle Ollama requis : transcription Whisper et synthèse Piper légères en local
# Prérequis : OPENROUTER_API_KEY dans .env
LLM_PROVIDER=openrouter
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
STT_PROVIDER=whisper
TTS_PROVIDER=piper

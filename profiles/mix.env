# Mix (défaut) : lfm3-audio local pour transcrire et parler, DeepSeek (OpenRouter) pour réfléchir
# Prérequis : ollama pull lfm3-audio, OPENROUTER_API_KEY dans .env
LLM_PROVIDER=openrouter
OPENROUTER_MODEL=deepseek/deepseek-v4-flash
STT_PROVIDER=ollama
OLLAMA_STT_MODEL=lfm3-audio
TTS_PROVIDER=ollama
OLLAMA_TTS_MODEL=lfm3-audio
OLLAMA_TTS_VOICE=female-french

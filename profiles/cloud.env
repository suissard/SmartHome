# Tout en ligne (OpenRouter) : Gemini 2.5 Flash comprend l'audio et réfléchit, voix Voxtral
# Prérequis : OPENROUTER_API_KEY dans .env
# Note : openai/gpt-audio (audio en entrée ET en sortie) existe sur OpenRouter mais le fournisseur LLM ne lit pas
# encore l'audio renvoyé par le modèle ; la voix passe donc par la synthèse OpenRouter.
LLM_PROVIDER=openrouter
OPENROUTER_MODEL=google/gemini-2.5-flash
STT_PROVIDER=direct
STT_FALLBACK_PROVIDER=openrouter
TTS_PROVIDER=openrouter

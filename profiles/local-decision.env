# Full local avec modèle de décision : nimble choisit la commande, réponses types, transcription Whisper, voix Piper
# Un seul modèle Ollama chargé à la fois : Whisper et Piper tournent hors d'Ollama pour ne pas saturer la machine
# Prérequis : ollama pull nimble
LLM_PROVIDER=ollama
OLLAMA_MODEL=nimble
LLM_DECISION_MODELS=nimble,tev1
STT_PROVIDER=whisper
TTS_PROVIDER=piper

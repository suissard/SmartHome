# ==========================================
# SMART HOME - CONFIGURATION GLOBALE
# ==========================================

# ------------------------------------------
# 🌐 FOURNISSEURS DE SERVICES (Providers)
# ------------------------------------------
# Choix du fournisseur LLM : "ollama" (local) ou "openrouter" (cloud)
LLM_PROVIDER=ollama

# Choix du fournisseur de transcription STT : 
# - "whisper" : Whisper local (faster-whisper)
# - "openrouter" : API STT distante (Whisper cloud)
# - "none" ou "direct" : Bypass STT (Audio brut envoyé directement aux LLM multimodaux comme Gemini Flash ou Voxtral)
STT_PROVIDER=whisper

# Choix du fournisseur de synthèse vocale TTS : "piper" (local) ou "openrouter" (cloud)
TTS_PROVIDER=piper

# ------------------------------------------
# ☁️ OPENROUTER / CLOUD CONFIGURATION
# ------------------------------------------
# Clé API OpenRouter (obligatoire si un des fournisseurs est défini sur "openrouter")
# Obtenir une clé sur : https://openrouter.ai/keys
OPENROUTER_API_KEY=

# URL de base de l'API OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modèle LLM pour OpenRouter (ex: meta-llama/llama-3.3-70b-instruct, google/gemini-2.5-flash, openai/gpt-4o-mini, anthropic/claude-3.5-sonnet)
OPENROUTER_MODEL=google/gemma-4-31b-it

# Modèle STT pour OpenRouter (ex: openai/whisper-large-v3, openai/whisper-1)
OPENROUTER_STT_MODEL=mistralai/voxtral-small-24b-2507-stt

# Modèle TTS pour OpenRouter (ex: openai/tts-1, openai/gpt-4o-mini-tts-2025-12-15)
OPENROUTER_TTS_MODEL=mistralai/voxtral-mini-tts-2603

# Voix TTS pour OpenRouter (ex: nova, alloy, echo, fable, onyx, shimmer)
OPENROUTER_TTS_VOICE=fr_marie_happy

# ------------------------------------------
# 🎙️ AUDIO GLOBAL (PyAudio / SoundDevice)
# ------------------------------------------
# Fréquence d'échantillonnage en Hz (16000 recommandé pour openWakeWord et Whisper)
AUDIO_RATE=16000

# Taille d'un paquet audio en nombre d'échantillons (1280 = 80ms à 16kHz)
AUDIO_CHUNK=1280

# Nombre de canaux audio (1 = Mono)
AUDIO_CHANNELS=1

# Index du périphérique audio d'entrée micro (laisser vide pour la valeur système par défaut)
AUDIO_INPUT_DEVICE_INDEX=

# Index du périphérique audio de sortie haut-parleur (laisser vide pour la valeur système par défaut)
AUDIO_OUTPUT_DEVICE_INDEX=

# ------------------------------------------
# ⚡ WAKE WORD (openWakeWord)
# ------------------------------------------
# Chemin vers le modèle ONNX du mot-clé
WAKEWORD_MODEL_PATH=wakewords/Salut_Jarvisse_20260601_005854.onnx

# Seuil de probabilité de détection (entre 0.0 et 1.0)
WAKEWORD_THRESHOLD=0.5

# ------------------------------------------
# 🗣️ TRANSCRIPTION / STT (faster-whisper)
# ------------------------------------------
# Modèle Whisper à charger (tiny, base, small, medium, large-v3)
WHISPER_MODEL=base

# Périphérique d'exécution Whisper (cpu ou cuda)
WHISPER_DEVICE=cpu

# Type de quantification (int8, float16, float32)
WHISPER_COMPUTE_TYPE=int8

# Langue pour la transcription
WHISPER_LANGUAGE=fr

# Largeur du faisceau (beam size) pour la recherche de décodage
WHISPER_BEAM_SIZE=3

# Seuil d'amplitude moyenne pour déclencher la détection de voix (VAD)
VOICE_THRESHOLD=700

# Durée de silence consécutif marquant la fin de parole (en secondes)
SILENCE_DURATION=0.8

# Durée maximale d'enregistrement de parole continue (en secondes)
MAX_SPEECH_DURATION=12.0

# Durée de la veille active / fenêtre de follow-up (en secondes).
# La barre d'écoulement du terminal s'adapte automatiquement et dynamiquement à cette valeur.
FOLLOW_UP_TIMEOUT=10.0

# ------------------------------------------
# 🧠 LLM / RAISONNEMENT (Ollama)
# ------------------------------------------
# Nom du modèle Ollama local
OLLAMA_MODEL=gemma4:12b

# URL de l'API Ollama (laisser vide pour http://localhost:11434 par défaut)
OLLAMA_HOST=http://localhost:11434

# Prompt système guidant le comportement du LLM
LLM_SYSTEM_PROMPT="Tu es un assistant vocal domotique. Réponds en français de manière claire, concise et directe (1 à 2 phrases max). N'utilise pas de markdown ou d'emoji."

# Activer l'affichage en streaming des tokens dans la console
LLM_STREAM=true

# Activer ou désactiver la réflexion/thinking des modèles de raisonnement (false = plus rapide)
LLM_THINK=false

# Nombre de phrases d'échange passées (utilisateur + assistant) conservées en mémoire pour le LLM (0 pour désactiver)
LLM_HISTORY_MESSAGES=5


# ------------------------------------------
# 🔊 SYNTHÈSE VOCALE / TTS (Piper TTS)
# ------------------------------------------
# Chemin vers le modèle de voix ONNX
TTS_MODEL_PATH=voice.onnx

# Chemin vers la configuration JSON du modèle de voix
TTS_CONFIG_PATH=voice.onnx.json

# Facteur de vitesse de la parole (1.0 = normal, 1.15 = dynamique)
TTS_SPEECH_SPEED=1.15

# Durée du fondu de sortie audio en secondes (anti-clics)
TTS_FADE_OUT_DURATION=0.05

# Silence ajouté au début de la synthèse en secondes
TTS_SILENCE_START_DURATION=0.10

# Silence ajouté à la fin de la synthèse en secondes
TTS_SILENCE_END_DURATION=0.40

# ------------------------------------------
# 🔔 SIGNAUX SONORES & RETOURS VOCAUX (Feedback)
# ------------------------------------------
# Type de retour à la détection du mot-clé ("phrase", "sound", ou "none")
FEEDBACK_WAKEWORD_TYPE=phrase

# Texte prononcé lors de la détection (si FEEDBACK_WAKEWORD_TYPE=phrase)
FEEDBACK_WAKEWORD_TEXT="Que puis je pour toi ?"

# Son joué lors de la détection (si FEEDBACK_WAKEWORD_TYPE=sound : wake, ding, sleep, beep, chime_up, chime_down, ou chemin .wav)
FEEDBACK_WAKEWORD_SOUND=wake

# Type de retour à la fin de réponse de l'IA ("sound", "phrase", ou "none")
FEEDBACK_RESPONSE_END_TYPE=sound

# Son joué à la fin de la réponse IA (signal de passage de parole à l'utilisateur)
FEEDBACK_RESPONSE_END_SOUND=ding

# Texte prononcé à la fin de la réponse IA (si FEEDBACK_RESPONSE_END_TYPE=phrase)
FEEDBACK_RESPONSE_END_TEXT="Ok"

# Type de retour lors de la fin de session / timeout d'écoute ("phrase", "sound", ou "none")
FEEDBACK_TIMEOUT_TYPE=phrase

# Texte prononcé lors de la mise en veille / fin d'écoute (si FEEDBACK_TIMEOUT_TYPE=phrase)
FEEDBACK_TIMEOUT_TEXT="Bisous a plus tard"

# Son joué lors de la fin d'écoute (si FEEDBACK_TIMEOUT_TYPE=sound)
FEEDBACK_TIMEOUT_SOUND=sleep

# Volume global des signaux sonores (entre 0.0 et 1.0)
FEEDBACK_SOUND_VOLUME=0.5

# ------------------------------------------
# 🔉 DUCKING / ATTÉNUATION SONORE SYSTÈME
# ------------------------------------------
# Activer ou désactiver l'atténuation automatique du son des autres applications
DUCKING_ENABLED=true

# Niveau de volume des autres applications pendant l'échange avec le bot (en %, 0 = muet)
DUCKING_VOLUME_PERCENT=20

# Rétablir automatiquement tous les volumes d'origine à la fermeture du script
DUCKING_RESTORE_ON_EXIT=true


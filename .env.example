# ==========================================
# SMART HOME - CONFIGURATION GLOBALE
# ==========================================
# Priorité : variables d'environnement > ce fichier > valeurs par défaut (une valeur vide = valeur par défaut).
# Profils : profiles/<nom>.env (mix par défaut, local-gemma, local-lfm, local-decision, cloud) surchargent ce fichier :
# ./start.sh --profile cloud, ou SMARTHOME_PROFILE=cloud. Les secrets (clés, jetons) restent ici.
# SMARTHOME_ENV_FILE=autre.env python main.py charge un autre fichier.
# Vérifier la configuration chargée : python core/config.py

# ------------------------------------------
# 🌐 FOURNISSEURS DE SERVICES (Providers)
# ------------------------------------------
# Choix du fournisseur LLM : "ollama" (local) ou "openrouter" (cloud)
LLM_PROVIDER=ollama

# Choix du fournisseur de transcription STT : 
# - "whisper" : Whisper local (faster-whisper)
# - "openrouter" : API STT distante (Whisper cloud)
# - "ollama" : modèle audio local d'Ollama (OLLAMA_STT_MODEL, ex: lfm3-audio)
# - "none" ou "direct" : Bypass STT (Audio brut envoyé directement aux LLM multimodaux comme Gemini Flash, Voxtral,
#   ou gemma4 / lfm3-audio sous Ollama). Si le modèle actif ne comprend pas l'audio, STT_FALLBACK_PROVIDER transcrit.
STT_PROVIDER=whisper

# Transcription de repli du mode direct, quand le modèle actif ne comprend pas l'audio ("whisper", "ollama" ou "openrouter")
STT_FALLBACK_PROVIDER=whisper

# Choix du fournisseur de synthèse vocale TTS : "piper" (local), "ollama" (local, OLLAMA_TTS_MODEL) ou "openrouter" (cloud)
TTS_PROVIDER=piper

# ------------------------------------------
# ☁️ OPENROUTER / CLOUD CONFIGURATION
# ------------------------------------------
# Clé API OpenRouter (obligatoire si un des fournisseurs est défini sur "openrouter")
# Obtenir une clé sur : https://openrouter.ai/keys
OPENROUTER_API_KEY=

# URL de base de l'API OpenRouter
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# Modèle LLM pour OpenRouter (ex: meta-llama/llama-3.3-70b-instruct, google/gemini-2.5-flash, openai/gpt-4o-mini, anthropic/claude-3.5-sonnet)
OPENROUTER_MODEL=google/gemma-4-31b-it

# Modèle STT pour OpenRouter (ex: openai/whisper-large-v3, openai/whisper-1)
OPENROUTER_STT_MODEL=mistralai/voxtral-small-24b-2507-stt

# Modèle TTS pour OpenRouter (ex: openai/tts-1, openai/gpt-4o-mini-tts-2025-12-15)
OPENROUTER_TTS_MODEL=mistralai/voxtral-mini-tts-2603

# Voix TTS pour OpenRouter (ex: nova, alloy, echo, fable, onyx, shimmer)
OPENROUTER_TTS_VOICE=fr_marie_happy

# ------------------------------------------
# 🎙️ AUDIO GLOBAL (PyAudio / SoundDevice)
# ------------------------------------------
# Fréquence d'échantillonnage en Hz (16000 recommandé pour openWakeWord et Whisper)
AUDIO_RATE=16000

# Taille d'un paquet audio en nombre d'échantillons (1280 = 80ms à 16kHz)
AUDIO_CHUNK=1280

# Nombre de canaux audio (1 = Mono)
AUDIO_CHANNELS=1

# Index du périphérique audio d'entrée micro (laisser vide pour la valeur système par défaut)
AUDIO_INPUT_DEVICE_INDEX=

# Index du périphérique audio de sortie haut-parleur (laisser vide pour la valeur système par défaut)
AUDIO_OUTPUT_DEVICE_INDEX=

# ------------------------------------------
# ⚡ WAKE WORD (openWakeWord)
# ------------------------------------------
# Chemin vers le modèle ONNX du mot-clé
WAKEWORD_MODEL_PATH=wakewords/Salut_Jarvisse_20260601_005854.onnx

# Seuil de probabilité de détection (entre 0.0 et 1.0)
WAKEWORD_THRESHOLD=0.5

# Écoute du mot-clé par le micro de l'ordinateur (false : plus de détection, utile contre les faux positifs ; la PWA reste utilisable)
WAKEWORD_ENABLED=true

# ------------------------------------------
# 🗣️ TRANSCRIPTION / STT (faster-whisper)
# ------------------------------------------
# Modèle Whisper à charger (tiny, base, small, medium, large-v3)
WHISPER_MODEL=base

# Périphérique d'exécution Whisper (cpu ou cuda)
WHISPER_DEVICE=cpu

# Type de quantification (int8, float16, float32)
WHISPER_COMPUTE_TYPE=int8

# Langue pour la transcription
WHISPER_LANGUAGE=fr

# Largeur du faisceau (beam size) pour la recherche de décodage
WHISPER_BEAM_SIZE=3

# Seuil d'amplitude moyenne pour déclencher la détection de voix (VAD)
VOICE_THRESHOLD=700

# Durée de silence consécutif marquant la fin de parole (en secondes)
SILENCE_DURATION=0.8

# Durée maximale d'enregistrement de parole continue (en secondes)
MAX_SPEECH_DURATION=12.0

# Détection de la parole : "silero" (réseau local fourni par openWakeWord, ignore le bruit ambiant)
# ou "energy" (niveau sonore seul : un ventilateur ou une musique peuvent déclencher l'écoute)
VAD_ENGINE=silero

# Probabilité de parole (0 à 1) à partir de laquelle une trame est considérée comme de la voix
VAD_SPEECH_THRESHOLD=0.5

# Durée minimale de parole pour qu'un enregistrement soit transcrit (un bruit bref est ignoré)
VAD_MIN_SPEECH_DURATION=0.3

# Filtre VAD de faster-whisper : retire les passages sans parole avant la transcription
WHISPER_VAD_FILTER=true

# Phrases que Whisper invente dans le bruit (séparées par des virgules) : une transcription identique est ignorée
STT_IGNORED_PHRASES=sous-titres réalisés par la communauté d'amara.org,sous-titres réalisés para la communauté d'amara.org,sous-titrage st' 501,sous-titrage société radio-canada,merci d'avoir regardé,merci d'avoir regardé cette vidéo,abonnez-vous,n'oubliez pas de vous abonner,applaudissements,rires

# Durée de la veille active / fenêtre de follow-up (en secondes).
# La barre d'écoulement du terminal s'adapte automatiquement et dynamiquement à cette valeur.
FOLLOW_UP_TIMEOUT=10.0

# Phrases qui terminent la conversation et remettent l'assistant en veille, sans passer par le LLM.
# Le LLM dispose aussi de l'outil « sleep » ([SLEEP]) pour les formulations libres (« je vais me coucher »).
CONVERSATION_END_PHRASES=stop,au revoir,c'est tout,ce sera tout,ça sera tout,ça ira,c'est bon,non c'est bon,non merci,bonne nuit,à plus,à plus tard,à bientôt,à tout à l'heure,ciao,bye,fin de conversation,va dormir,dors,mets-toi en veille,en veille,veille,tais-toi,laisse tomber,rien,j'ai fini,terminé

# Mots ignorés autour de ces phrases (« Merci, au revoir ! » équivaut à « au revoir »)
CONVERSATION_END_FILLERS=merci,beaucoup,ok,okay,bon,bah,ben,alors,eh,euh,bien,jarvis,pour,moi

# ------------------------------------------
# 🧠 LLM / RAISONNEMENT (Ollama)
# ------------------------------------------
# Nom du modèle Ollama local
OLLAMA_MODEL=gemma4:12b

# URL de l'API Ollama (laisser vide pour http://localhost:11434 par défaut)
OLLAMA_HOST=http://localhost:11434

# Modèles audio d'Ollama, utilisés par STT_PROVIDER=ollama et TTS_PROVIDER=ollama (capacités "audio" et "speech").
# Installation : ollama pull lfm3-audio (Ollama >= 0.40.12)
OLLAMA_STT_MODEL=lfm3-audio

# Modèle vocal d'Ollama pour TTS_PROVIDER=ollama (capacité "speech")
OLLAMA_TTS_MODEL=lfm3-audio

# Voix de la synthèse Ollama : "female" ou "male", suivi éventuellement d'une langue (female-french, male-french,
# female-british-english...) ; vide = voix par défaut du modèle. Seule la vitesse 1 est disponible (TTS_SPEECH_SPEED ignoré)
OLLAMA_TTS_VOICE=female-french

# Délai maximal d'une transcription ou d'une synthèse Ollama (secondes)
OLLAMA_AUDIO_TIMEOUT=30

# Prompt système guidant le comportement du LLM
LLM_SYSTEM_PROMPT="Tu es un assistant vocal domotique. Réponds en français de manière claire, concise et directe (1 à 2 phrases max). N'utilise pas de markdown ou d'emoji."

# Ajoute la date et l'heure courantes (recalculées à chaque demande) à la fin du prompt système
LLM_INJECT_DATETIME=true

# Activer l'affichage en streaming des tokens dans la console
LLM_STREAM=true

# Activer ou désactiver la réflexion/thinking des modèles de raisonnement (false = plus rapide)
LLM_THINK=false

# Nombre de phrases d'échange passées (utilisateur + assistant) conservées en mémoire pour le LLM (0 pour désactiver)
LLM_HISTORY_MESSAGES=5

# Mode d'appel d'outils : "native" (function calling du modèle), "tags" ([VOLUME 40] dans le texte),
# "auto" (native, puis repli automatique sur les tags si le modèle ne gère pas les outils)
LLM_TOOL_CALLING=auto

# Nombre maximal d'allers-retours outil -> LLM pour une même demande
LLM_MAX_TOOL_ROUNDS=4

# Entrée audio du LLM en mode STT direct : "auto" (d'après les capacités annoncées par le modèle :
# capacité "audio" d'Ollama, modalités d'entrée d'OpenRouter), "on" (toujours envoyer l'audio), "off" (toujours transcrire)
LLM_AUDIO_INPUT=auto

# Entrée image du LLM (images jointes depuis l'interface web) : "auto" (capacité "vision" d'Ollama, modalité "image"
# d'OpenRouter), "on" (toujours envoyer), "off" (jamais : l'utilisateur est prévenu)
LLM_IMAGE_INPUT=auto

# ------------------------------------------
# 🎯 MODÈLES DE DÉCISION (Ollama /v1/systemone : nimble, tev1...)
# ------------------------------------------
# Un modèle de décision ne rédige pas de réponse : il choisit la commande (outil) et ses arguments parmi des choix fermés,
# puis SmartHome prononce une réponse type décrivant ce qui a été compris. Sélection : OLLAMA_MODEL=nimble
# Modèles traités comme modèles de décision (séparés par des virgules ; le tag ":latest" est facultatif)
LLM_DECISION_MODELS=nimble,tev1

# Question posée au modèle pour choisir la commande parmi les outils
LLM_DECISION_PROMPT="Quelle commande l'utilisateur demande-t-il d'exécuter ? Choisis « aucune » s'il ne demande aucune de ces commandes (question, discussion, demande impossible)."

# Probabilité minimale (0 à 1) de la commande choisie ; en dessous, la demande est considérée comme non comprise
LLM_DECISION_MIN_CONFIDENCE=0.5

# Réponses types. Variables : ${COMMAND} (commande comprise), ${ARGS} (arguments choisis), ${OUTPUT} (résultat de l'outil),
# ${TOOL} (nom de l'outil) et ${<ARGUMENT>} pour chaque argument d'un outil MCP (ex: ${ROOM})
LLM_DECISION_DONE_TEMPLATE="Commande ${COMMAND} initiée avec ${ARGS}."
LLM_DECISION_DONE_NO_ARGS_TEMPLATE="Commande ${COMMAND} initiée."
LLM_DECISION_REFUSED_TEMPLATE="Commande non exécutée : ${COMMAND}."

# Message de confirmation par commande, au format JSON {"outil": "gabarit"} : prioritaire sur le message déclaré
# par l'action (actions/modules/*.py), puis sur les réponses types ci-dessus. Ex: {"volume": "C'est parti, volume ${ARGS}."}
LLM_DECISION_MESSAGES={}
LLM_DECISION_UNKNOWN_TEXT="Je n'ai pas compris la commande."

# Délai maximal d'une décision en secondes (le premier appel charge le modèle en mémoire)
LLM_DECISION_TIMEOUT=60


# ------------------------------------------
# 🔊 SYNTHÈSE VOCALE / TTS (Piper TTS)
# ------------------------------------------
# Nom de la voix locale dans le dossier voices/ (ex: fr_FR-siwis-medium, fr_FR-upmc-medium, fr_FR-tom-medium)
# Noms courts acceptés : "siwis", "upmc", "tom"
TTS_VOICE=fr_FR-siwis-medium

# Chemin explicite vers le modèle de voix ONNX (optionnel si TTS_VOICE est défini)
TTS_MODEL_PATH=voices/fr_FR-siwis-medium.onnx

# Chemin explicite vers la configuration JSON du modèle de voix (optionnel si TTS_VOICE est défini)
TTS_CONFIG_PATH=voices/fr_FR-siwis-medium.onnx.json

# Facteur de vitesse de la parole (1.0 = normal, 1.15 = dynamique)
TTS_SPEECH_SPEED=1.15

# Voix Piper supplémentaires gardées en mémoire, pour les voix choisies par les comptes (~100 Mo chacune ; 0 = rechargée à chaque phrase)
TTS_VOICE_CACHE_SIZE=2

# Phrase prononcée pour écouter une voix avant de la choisir (PWA, Réglages → Mon profil)
TTS_VOICE_PREVIEW_TEXT=Bonjour, voici ma voix. Elle vous convient ?

# Durée du fondu de sortie audio en secondes (anti-clics)
TTS_FADE_OUT_DURATION=0.05

# Silence ajouté au début de la synthèse en secondes (marge anti-coupure DAC / HDMI / PipeWire)
TTS_SILENCE_START_DURATION=0.25

# Silence ajouté à la fin de la synthèse en secondes
TTS_SILENCE_END_DURATION=0.40

# Parler phrase par phrase pendant que le LLM génère la suite (au lieu d'attendre la réponse complète)
TTS_STREAMING=true

# Longueur minimale d'un morceau prononcé : les phrases plus courtes sont regroupées avec la suivante
TTS_STREAM_MIN_CHARS=25

# ------------------------------------------
# ✋ BARGE-IN (couper la parole à l'assistant)
# ------------------------------------------
# "wakeword" : redire le mot-clé pendant que l'assistant parle (robuste à l'écho des haut-parleurs)
# "voice"    : toute voix forte interrompt (casque ou annulation d'écho PipeWire conseillés), "off" : désactivé
BARGE_IN_MODE=wakeword

# Mode "voice" : niveau moyen (même échelle que VOICE_THRESHOLD) et durée continue pour déclencher l'interruption
BARGE_IN_VOICE_THRESHOLD=2500
BARGE_IN_MIN_DURATION=0.3

# Son joué quand l'assistant est interrompu (wake, ding, beep... ou chemin .wav ; vide = aucun)
BARGE_IN_SOUND=wake

# ------------------------------------------
# 📱 VOIX DISTANTE (micro du téléphone)
# ------------------------------------------
# Quand on parle par le micro de la PWA, l'ordinateur entend la même voix : il ignore alors le mot-clé
# et quitte l'écoute active pour repasser en veille
REMOTE_VOICE_SLEEP=true

# Délai de garde après la fermeture du micro distant (s)
REMOTE_VOICE_HOLD=3.0

# ------------------------------------------
# 🔔 SIGNAUX SONORES & RETOURS VOCAUX (Feedback)
# ------------------------------------------
# Type de retour à la détection du mot-clé ("phrase", "sound", ou "none")
FEEDBACK_WAKEWORD_TYPE=phrase

# Texte prononcé lors de la détection (si FEEDBACK_WAKEWORD_TYPE=phrase)
FEEDBACK_WAKEWORD_TEXT="Que puis je pour toi ?"

# Son joué lors de la détection (si FEEDBACK_WAKEWORD_TYPE=sound : wake, ding, sleep, beep, chime_up, chime_down, ou chemin .wav)
FEEDBACK_WAKEWORD_SOUND=wake

# Type de retour à la fin de réponse de l'IA ("sound", "phrase", ou "none")
FEEDBACK_RESPONSE_END_TYPE=sound

# Son joué à la fin de la réponse IA (signal de passage de parole à l'utilisateur)
FEEDBACK_RESPONSE_END_SOUND=ding

# Texte prononcé à la fin de la réponse IA (si FEEDBACK_RESPONSE_END_TYPE=phrase)
FEEDBACK_RESPONSE_END_TEXT="Ok"

# Type de retour lors de la fin de session / timeout d'écoute ("phrase", "sound", ou "none")
FEEDBACK_TIMEOUT_TYPE=phrase

# Texte prononcé lors de la mise en veille / fin d'écoute (si FEEDBACK_TIMEOUT_TYPE=phrase)
FEEDBACK_TIMEOUT_TEXT="Bisous a plus tard"

# Son joué lors de la fin d'écoute (si FEEDBACK_TIMEOUT_TYPE=sound)
FEEDBACK_TIMEOUT_SOUND=sleep

# Volume global des signaux sonores (entre 0.0 et 1.0)
FEEDBACK_SOUND_VOLUME=0.5

# ------------------------------------------
# 🔉 DUCKING / ATTÉNUATION SONORE SYSTÈME
# ------------------------------------------
# Activer ou désactiver l'atténuation automatique du son des autres applications
DUCKING_ENABLED=true

# Niveau de volume des autres applications pendant l'échange avec le bot (en %, 0 = muet)
DUCKING_VOLUME_PERCENT=20

# Rétablir automatiquement tous les volumes d'origine à la fermeture du script
DUCKING_RESTORE_ON_EXIT=true

# Mettre en pause la musique / vidéo en cours (MPRIS, via playerctl) dès le mot-clé, et la relancer
# à la fin de l'échange. Un média déjà en pause avant le mot-clé n'est pas relancé.
# Quand la pause est active, le ducking ci-dessus est ignoré (la pause suffit, sans manipuler les volumes).
MEDIA_PAUSE_ENABLED=true

# ------------------------------------------
# ⚡ ACTIONS & COMMANDES SYSTÈME
# ------------------------------------------
# Activer le système de déclenchement d'actions par tags ([SHUTDOWN], [VOLUME], etc.)
ACTIONS_ENABLED=true

# Injecter dynamiquement la liste des commandes disponibles dans le prompt du LLM
ACTIONS_DYNAMIC_PROMPT=true

# Applications que [OPEN] peut lancer directement, séparées par des virgules
# (les catégories navigateur, musique, code, terminal, fichiers, calculatrice, paramètres restent toujours autorisées)
ACTIONS_OPEN_ALLOWED_APPS=firefox,google-chrome,chromium,brave-browser,microsoft-edge,spotify,vlc,elisa,rhythmbox,code,vscodium,kate,gedit,dolphin,nautilus,thunar,kcalc,gnome-calculator,discord,steam,obs,gimp,libreoffice

# Confirmation vocale avant les actions dangereuses (extinction, redémarrage, outils MCP destructeurs)
ACTIONS_CONFIRM_DANGEROUS=true

# Délai (secondes) pour répondre à la demande de confirmation
ACTIONS_CONFIRM_TIMEOUT=6

# Mots acceptés comme confirmation (séparés par des virgules)
ACTIONS_CONFIRM_WORDS=oui,ouais,confirme,confirmé,vas-y,vas y,ok,d'accord,go,yes

# Mots d'annulation (l'emportent toujours sur un mot de confirmation)
ACTIONS_CANCEL_WORDS=non,annule,annuler,stop,attends,pas

# Question posée avant une action dangereuse ({action} = description de l'action)
ACTIONS_CONFIRM_PROMPT="Tu confirmes : {action} ?"

# Durée maximale d'exécution d'une action locale appelée comme outil (secondes)
ACTIONS_TIMEOUT=10

# Dossier où [SCREENSHOT] enregistre les captures d'écran
ACTIONS_SCREENSHOT_DIR=~/Pictures

# Durée maximale d'un minuteur [TIMER] (secondes)
ACTIONS_TIMER_MAX_SECONDS=86400

# Création de commandes par IA [CREATE_COMMAND] (réservée aux superadmins) : agent IA local lancé en arrière-plan.
# Commande de l'agent (Antigravity par défaut), modèle (`agy models`), répertoire de travail (vide = racine du projet)
ACTIONS_AGENT_COMMAND=agy --dangerously-skip-permissions
ACTIONS_AGENT_MODEL=claude-opus-5-5-high
ACTIONS_AGENT_DIR=

# Durée maximale du travail de l'agent (secondes), guide envoyé avec la consigne, dossier des journaux
ACTIONS_AGENT_TIMEOUT=1800
ACTIONS_AGENT_GUIDE=actions/CUSTOM_COMMAND_GUIDE.md
ACTIONS_AGENT_LOG_DIR=logs/agent

# Longueur maximale de la consigne transmise à l'agent (caractères)
ACTIONS_AGENT_MAX_REQUEST_CHARS=2000

# Modification de ses propres paramètres par l'assistant ([GET_SETTINGS] / [SET_SETTING], administrateurs seulement,
# confirmation toujours demandée) : paramètres qu'il ne peut ni lire ni modifier (séparés par des virgules).
# Garder les limites de sécurité (dossiers lisibles, applications ouvrables) : sinon l'assistant pourrait les élargir lui-même
ACTIONS_SETTINGS_BLOCKED=OPENROUTER_API_KEY,ACTIONS_CONFIRM_DANGEROUS,FILES_SEARCH_DIRS,ACTIONS_OPEN_ALLOWED_APPS

# Longueur maximale d'une valeur lue par [GET_SETTINGS] (caractères, au-delà : tronquée)
ACTIONS_SETTINGS_MAX_VALUE_CHARS=200

# ------------------------------------------
# 🤝 AGENTS EXTERNES (Hermes, Claude Code, Antigravity...)
# ------------------------------------------
# « J'aimerais parler à Hermes » relie la conversation (micro et PWA) à un agent installé sur la machine, qui répond
# directement, dans une autre voix, jusqu'à « reviens » / « parler à Jarvis ». Agents décrits dans agents.json
AGENTS_ENABLED=true

# Fichier des agents (commande, reprise de session, couleur, voix : voir core/agents.py)
AGENTS_CONFIG_FILE=agents.json

# Rôles autorisés à parler aux agents (ils agissent avec les droits du système ; les superadmins le sont toujours)
AGENTS_ROLES=admin

# Formules qui, suivies du nom d'un agent, basculent vers lui sans passer par le LLM (« passe-moi Hermes »)
AGENTS_SWITCH_TRIGGERS=parler à,parler a,parler avec,causer avec,discuter avec,passe-moi,passe moi,passez-moi,connecte-moi à,connecte moi à,connecte-moi avec,mets-moi en relation avec,mettre en relation avec,bascule sur,bascule vers,basculer sur,appelle,reviens à,reviens a,reviens avec,retour à,repasse-moi,repasse moi,rends-moi,rends moi

# Mots de courtoisie ignorés après le nom de l'agent (« passe-moi Hermes s'il te plaît » : rien à lui transmettre)
AGENTS_SWITCH_FILLERS=s'il te plaît,s'il te plait,s il te plaît,s'il vous plaît,s'il vous plait,stp,svp,merci,maintenant,please,steuplé,tout de suite,directement

# Noms de l'assistant : « parler à Jarvis » pendant un échange avec un agent ramène à l'assistant
AGENTS_ASSISTANT_NAMES=assistant,l'assistant,jarvis,smarthome,smart home

# Phrases (énoncé entier) qui quittent l'agent et rendent la parole à l'assistant
AGENTS_RETURN_PHRASES=reviens,retour,retour à l'assistant,reviens à l'assistant,repasse-moi l'assistant,raccroche,quitte l'agent,fin de l'agent,déconnecte l'agent,c'est fini avec l'agent,merci l'agent

# Annonce prononcée par l'agent quand la conversation lui est confiée (${AGENT} : nom de l'agent)
AGENTS_SWITCH_MESSAGE=${AGENT} à l'écoute.

# Annonce de l'assistant quand il reprend la main
AGENTS_RETURN_MESSAGE=Me revoilà.

# Réponse quand le compte n'a pas accès aux agents (${AGENT})
AGENTS_DENIED_MESSAGE=Je ne peux pas vous mettre en relation avec ${AGENT} : accès réservé aux administrateurs.

# Réponse quand l'agent échoue (${AGENT}, ${ERROR})
AGENTS_ERROR_MESSAGE=${AGENT} ne répond pas : ${ERROR}

# Consigne ajoutée devant chaque message transmis à l'agent (sa réponse est lue à voix haute)
AGENTS_PROMPT_PREFIX=[Message transmis par l'assistant vocal SmartHome : réponds brièvement, en texte simple sans markdown ni tableau, ta réponse sera lue à voix haute.]

# Délai maximal d'une réponse d'agent (secondes), sauf "timeout" propre à l'agent dans agents.json
AGENTS_TIMEOUT=600

# Délai laissé à un agent interrompu (ou hors délai) pour s'arrêter avant d'être tué de force (secondes)
AGENTS_KILL_GRACE=3

# Voix (voices/) d'un agent sans "voice" dans sa fiche ; vide = une autre voix installée que celle de l'assistant
AGENTS_DEFAULT_VOICE=

# Fin de conversation (« au revoir », mise en veille) : l'assistant reprend la main
AGENTS_LEAVE_ON_SLEEP=true

# ------------------------------------------
# 🖼️ IMAGES & RECHERCHE DE FICHIERS (interface web)
# ------------------------------------------
# Images jointes aux messages (bouton trombone, coller, glisser-déposer) et images montrées par l'assistant
IMAGES_ENABLED=true

# Taille maximale d'une image (octets) et nombre maximal d'images par message
IMAGES_MAX_BYTES=8000000
IMAGES_MAX_PER_MESSAGE=4

# Plus grand côté (pixels) d'une image jointe : le navigateur la réduit avant l'envoi (0 = taille d'origine)
IMAGES_MAX_SIDE=1600

# Réponse quand le modèle ne lit pas les images (${MODEL} : nom du modèle) ; le texte du message est traité quand même
IMAGES_NO_VISION_MESSAGE=Le modèle ${MODEL} ne sait pas lire les images : seul le texte de votre message lui a été transmis.

# Dossier où sont copiées les images transmises à un agent externe (il reçoit leur chemin), relatif au projet
IMAGES_UPLOAD_DIR=uploads

# Dossiers (séparés par des virgules, ~ accepté) où l'assistant peut chercher des fichiers (outil search_files)
# et prendre les images qu'il vous montre (outil show_image). Rien n'est lu en dehors de ces dossiers.
FILES_SEARCH_DIRS=~/Images,~/Pictures

# Nombre maximal de résultats d'une recherche et profondeur maximale des sous-dossiers parcourus
FILES_SEARCH_MAX_RESULTS=20
FILES_SEARCH_MAX_DEPTH=6

# Extensions considérées comme des images
FILES_IMAGE_EXTENSIONS=.png,.jpg,.jpeg,.gif,.webp,.bmp

# ------------------------------------------
# 🔌 MCP SERVER & CLIENT HUB (Model Context Protocol)
# ------------------------------------------
# Mode de transport serveur : "stdio" (local pour Claude Desktop, Cursor, Antigravity) ou "sse" / "streamable-http" (réseau)
MCP_TRANSPORT=stdio

# Hôte d'écoute pour les modes réseau SSE / HTTP.
# 127.0.0.1 = local uniquement (défaut). Pour l'accès distant, préférez l'IP Tailscale (100.x.y.z) à 0.0.0.0.
# Hors loopback, MCP_AUTH_TOKEN est obligatoire.
MCP_HOST=127.0.0.1

# Jeton Bearer exigé par les clients réseau (en-tête "Authorization: Bearer <jeton>"). Générer : openssl rand -hex 32
MCP_AUTH_TOKEN=

# Seul dossier depuis lequel l'outil MCP stt_transcribe_file peut lire des fichiers .wav
MCP_AUDIO_DIR=recordings

# Port d'écoute pour les modes réseau SSE / HTTP
MCP_PORT=8080

# Activer le client Hub MCP dans main.py pour se connecter à d'autres serveurs MCP
MCP_CLIENT_ENABLED=true

# Fichier JSON contenant la liste des serveurs MCP auxquels se connecter
MCP_SERVERS_CONFIG_PATH=mcp_servers.json

# ------------------------------------------
# 🌍 PASSERELLE (clients distants : WebSocket /ws et HTTP /api/ask)
# ------------------------------------------
# Démarre la passerelle dans main.py, à côté de l'écoute micro (sinon : python -m gateway pour un serveur sans micro)
GATEWAY_ENABLED=false

# Adresse d'écoute : 127.0.0.1 (local) ou IP Tailscale 100.x.y.z pour l'accès distant. Hors loopback, le jeton est obligatoire.
GATEWAY_HOST=127.0.0.1

# Port d'écoute de la passerelle
GATEWAY_PORT=8765

# Jeton exigé par les clients (en-tête "Authorization: Bearer <jeton>" ou premier message WebSocket). Générer : openssl rand -hex 32
GATEWAY_AUTH_TOKEN=

# URL publique de l'interface web (ex: https://pc.tailnet.ts.net avec `tailscale serve`). Vide : déduite de GATEWAY_HOST et GATEWAY_PORT
GATEWAY_PUBLIC_URL=

# Détecte Tailscale : URL HTTPS de `tailscale serve` pour ce port, ou IP Tailscale si GATEWAY_HOST=0.0.0.0 (ignoré si GATEWAY_PUBLIC_URL est définie)
GATEWAY_TAILSCALE_URL=true

# Affiche au démarrage l'URL de connexion (jeton compris) et son QR code : à scanner avec le téléphone
GATEWAY_QR_ENABLED=true

# Délai laissé à un client distant pour confirmer une action dangereuse (secondes)
GATEWAY_CONFIRM_TIMEOUT=20

# Durée d'inactivité après laquelle une session distante (et son historique) est oubliée (secondes)
GATEWAY_SESSION_TIMEOUT=3600

# Taille maximale d'un message WebSocket (audio base64 compris), en octets
GATEWAY_MAX_MESSAGE_BYTES=10485760

# ==========================================
# 👥 COMPTES UTILISATEURS (PWA)
# ==========================================
# Annuaire des comptes : none (jeton unique GATEWAY_AUTH_TOKEN, comme avant) | pocketbase (un compte par personne).
# Le jeton GATEWAY_AUTH_TOKEN reste valable : accès administrateur, serveur MCP, client en ligne de commande
AUTH_PROVIDER=none

# Adresse du serveur PocketBase (sur cette machine : il n'est jamais exposé, la passerelle lui parle à la place de la PWA)
POCKETBASE_URL=http://127.0.0.1:8090

# Collection des comptes dans PocketBase (champ « role » ajouté par pocketbase/pb_migrations)
POCKETBASE_USERS_COLLECTION=users

# Collection de l'historique des conversations des comptes (créée par pocketbase/pb_migrations, conservé sans limite)
POCKETBASE_MESSAGES_COLLECTION=messages

# Délai maximal d'une requête à PocketBase (secondes)
POCKETBASE_TIMEOUT=5

# Lancer PocketBase avec SmartHome (binaire pocketbase/pocketbase du projet) quand POCKETBASE_URL est locale et ne répond pas
POCKETBASE_AUTOSTART=true

# Version installée par `python -m core.pocketbase install` (archive officielle, somme de contrôle vérifiée)
POCKETBASE_VERSION=0.40.6

# Rôle d'un compte dont le champ « role » est vide
AUTH_DEFAULT_ROLE=member

# Rôles autorisés à modifier les paramètres et à redémarrer SmartHome (séparés par des virgules)
AUTH_ADMIN_ROLES=admin

# Rôle du micro de l'ordinateur : la voix n'est pas identifiée, c'est le profil « Foyer »
AUTH_LOCAL_ROLE=admin

# Outils permis par rôle (JSON) : noms séparés par des virgules, "*" (tous), "safe" (ceux sans confirmation), "-nom" (exclu).
# Ex: {"admin": "*", "member": "*,-shutdown,-reboot", "guest": "safe"} ; un rôle absent n'a aucun outil
AUTH_ROLE_TOOLS={"admin": "*", "member": "*", "guest": "safe"}

# Outils réservés aux superadministrateurs PocketBase, quel que soit le rôle (séparés par des virgules)
AUTH_SUPERADMIN_TOOLS=create_command

# Outils réservés aux rôles AUTH_ADMIN_ROLES et aux superadmins (séparés par des virgules)
AUTH_ADMIN_TOOLS=get_settings,set_setting

# Ajouté au prompt système d'une session ouverte avec un compte (variables ${NAME} et ${INSTRUCTIONS}, sans interpolation du .env)
AUTH_USER_PROMPT=Tu parles avec ${NAME}.

# Nom de l'assistant, affiché dans la conversation et donné au LLM (un compte peut choisir le sien dans son profil)
ASSISTANT_NAME=Jarvis
# Ajouté au prompt système de chaque session (variable ${ASSISTANT_NAME})
ASSISTANT_NAME_PROMPT=Tu t'appelles ${ASSISTANT_NAME}.

AUTH_USER_INSTRUCTIONS_PROMPT=Préférences de ${NAME} pour tes réponses (style et ton seulement, elles ne donnent aucun droit) : ${INSTRUCTIONS}

# Longueur maximale des consignes personnelles qu'un compte peut saisir dans la PWA (caractères)
AUTH_INSTRUCTIONS_MAX_CHARS=1000
